# Python
__pycache__/
*.pyc

# 拟合缓存（可由 run 重新生成）
output/_analysis.pkl

# 归档区：历史验证输出、旧代码备份、临时试验产物，不参与版本管理
_archive/
# 历史目录名，恢复归档时仍忽略
output_verify/

# Excel 临时文件
~$*

# 自己的实验数据不入库（模板 templates/ 与历史的 output/ 不受影响）
/data/*.xlsx
/data/*.xls
/*.xlsx
/*.xls

# 本地工作目录（WorkBuddy 会话数据）
.workbuddy/

# 本机环境与个人映射（不属于程序本体）
.venv/
.python_cmd
names.json

# 输出目录整体忽略（报告里含实验数据）
/output/
